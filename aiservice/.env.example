# Sanctorum AI service — Phase 1. Copy to .env and fill in.

# OpenRouter (LiteLLM routes to it). Get a key at https://openrouter.ai/keys
# Phase 1 makes REAL, paid LLM calls once this is set. Leave blank to keep the
# service running but reject runs until a key is present.
OPENROUTER_API_KEY=

# The model to use, as a LiteLLM model string. OpenRouter models are prefixed
# "openrouter/". Examples:
#   openrouter/anthropic/claude-3.5-sonnet
#   openrouter/openai/gpt-4o-mini
#   openrouter/google/gemini-flash-1.5
DEFAULT_MODEL=openrouter/anthropic/claude-3.5-sonnet

# Serper (web search tool). Get a key at https://serper.dev . Optional — the
# search tool returns an error if unset.
SERPER_API_KEY=

# This service's port.
PORT=8000

# Where the Node backend lives — RuntimeEvents are POSTed here.
BACKEND_URL=http://localhost:3001
