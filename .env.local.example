# Copy to .env.local and fill in. .env.local is gitignored.
#
# Provider keys can also be entered in the app's Settings panel, which stores
# them in the database and prefers them over these. These are the fallback for
# running the services directly.

# OPENROUTER_API_KEY=
# SERPER_API_KEY=
# REPLICATE_API_TOKEN=

# Cross-process tracing (see README "Debugging")
# SANCTORUM_TRACE=1
# PRISMA_LOG_QUERIES=1
